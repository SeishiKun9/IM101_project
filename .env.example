PORT=3000
DATABASE_URL=postgresql://app_user:change_me@your-cloud-host.example/lost_found
NODE_ENV=development
# Required only for the one-time protected Administrator registration flow.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-value

# ==============================================================================
# EMAIL DELIVERY CONFIGURATION
# ==============================================================================
# OPTION B: Resend (Quickest - 30 seconds setup, no Google 2FA or App Passwords)
# 1. Sign up at https://resend.com (using GitHub or Google)
# 2. Go to "API Keys" -> "Create API Key"
# 3. Paste your key:
# RESEND_API_KEY=re_123456789abcdef
# RESEND_FROM="Campus Lost & Found <onboarding@resend.dev>"
#
# OPTION A: Gmail / Google Workspace (Using an App Password)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and App Password:
# SMTP_SERVICE=gmail
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="Campus Lost & Found" <your-account@gmail.com>
#
# OPTION B: Custom SMTP (Brevo, SendGrid, Mailgun, AWS SES, or School SMTP Server)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Campus Lost & Found" <no-reply@campuslostandfound.edu>