PORT=3000
DATABASE_URL=postgresql://app_user:change_me@your-cloud-host.example/lost_found
NODE_ENV=development
# Required only for the one-time protected Administrator registration flow.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-value

# ==============================================================================
# EMAIL / SMTP CONFIGURATION
# ==============================================================================
# Configure this to send REAL emails for:
# - Password Reset instructions
# - Match Alerts (when a found item matches a lost report)
# - Claim Decisions (approval pickup instructions & rejection notes)
# - Handover Receipts (when an item is collected)
# - Claim Messages (when staff asks questions on a claim)
#
# OPTION A: Gmail (Quickest setup)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and App Password:
# SMTP_SERVICE=gmail
# SMTP_USER=your-account@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_FROM="Campus Lost & Found" <your-account@gmail.com>
#
# OPTION B: Brevo REST API (Fastest & firewall-proof over HTTPS)
# BREVO_API_KEY=xkeysib-your-brevo-api-key
# SMTP_FROM="Campus Lost & Found" <your-verified-email@gmail.com>
#
# OPTION C: Custom SMTP (Brevo Relay, SendGrid, Mailgun, AWS SES, or School SMTP Server)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-login
# SMTP_PASS=your-smtp-password
# SMTP_FROM="Campus Lost & Found" <no-reply@campuslostandfound.edu>