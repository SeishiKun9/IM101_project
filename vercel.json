{
  "framework": "vite",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "{db/*.sql,uploads/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:__api_path*",
      "destination": "/api/index"
    }
  ]
}
